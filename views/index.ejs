<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <form action="/get-qr" method="POST">
      <button type="submit">Get QR Code</button>
    </form>

    <div>
      <% if (qr) { %>
      <img src="<%= qr %>" alt="QR Code" />
      <% } %>
    </div>
  </body>
</html>
