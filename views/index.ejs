<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ARVDN QR Market</title>
  <link rel="stylesheet" href="/stylesheets/build.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet" />
</head>

<body
  class="min-h-screen bg-[radial-gradient(1100px_circle_at_10%_10%,#ffe8c7_0%,transparent_55%),radial-gradient(900px_circle_at_90%_0%,#d6f5ff_0%,transparent_50%),linear-gradient(180deg,#f8fafc_0%,#f3f7ff_45%,#f9f6ef_100%)] text-slate-900 font-['Outfit']">
  <main class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <header class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.4em] text-slate-500">Smart vending</p>
        <h1 class="mt-2 text-4xl sm:text-5xl font-['Space_Grotesk'] font-semibold text-slate-900">
          ARVDN QR Market
        </h1>
        <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-xl">
          Handpicked snacks and refreshers, ready in seconds. Build your order and scan to pay.
        </p>
      </div>
      <div class="flex items-center gap-3 rounded-full bg-white/70 px-4 py-2 shadow-sm">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        <p class="text-sm text-slate-600">Machine online</p>
      </div>
    </header>

    <section class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
      <div>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <h2 class="text-2xl font-['Space_Grotesk'] font-semibold">Pick your favorites</h2>
          <p class="text-sm text-slate-500">Tap add to build your cart</p>
        </div>
        <!-- Product Container -->
        <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Item 1 -->
          <div
            class="group relative overflow-hidden rounded-2xl border border-white/60 bg-white/80 p-4 shadow-lg transition hover:-translate-y-1 hover:shadow-xl">
            <div
              class="absolute inset-0 bg-gradient-to-br from-white/70 via-white/40 to-transparent opacity-0 transition group-hover:opacity-100">
            </div>
            <div class="relative flex flex-col items-center gap-3 text-center">
              <img src="/images/chip.png" alt="chip" class="h-28 w-28 sm:h-32 sm:w-32" />
              <div>
                <p class="text-lg font-['Space_Grotesk'] font-semibold">Chip</p>
                <p class="text-sm text-slate-500">Price: RM 1.00</p>
              </div>
              <button
                class="mt-2 w-full rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 add-button"
                data-item-id="1" data-item-name="chip" data-item-price="1.00">
                Add to cart
              </button>
            </div>
          </div>
          <!-- Item 2 -->
          <div
            class="group relative overflow-hidden rounded-2xl border border-white/60 bg-white/80 p-4 shadow-lg transition hover:-translate-y-1 hover:shadow-xl">
            <div
              class="absolute inset-0 bg-gradient-to-br from-white/70 via-white/40 to-transparent opacity-0 transition group-hover:opacity-100">
            </div>
            <div class="relative flex flex-col items-center gap-3 text-center">
              <img src="/images/chocolate.png" alt="chocolate" class="h-28 w-28 sm:h-32 sm:w-32" />
              <div>
                <p class="text-lg font-['Space_Grotesk'] font-semibold">Chocolate</p>
                <p class="text-sm text-slate-500">Price: RM 0.10</p>
              </div>
              <button
                class="mt-2 w-full rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 add-button"
                data-item-id="2" data-item-name="chocolate" data-item-price="0.10">
                Add to cart
              </button>
            </div>
          </div>
          <!-- Item 3 -->
          <div
            class="group relative overflow-hidden rounded-2xl border border-white/60 bg-white/80 p-4 shadow-lg transition hover:-translate-y-1 hover:shadow-xl">
            <div
              class="absolute inset-0 bg-gradient-to-br from-white/70 via-white/40 to-transparent opacity-0 transition group-hover:opacity-100">
            </div>
            <div class="relative flex flex-col items-center gap-3 text-center">
              <img src="/images/cola.png" alt="cola" class="h-28 w-28 sm:h-32 sm:w-32" />
              <div>
                <p class="text-lg font-['Space_Grotesk'] font-semibold">Cola</p>
                <p class="text-sm text-slate-500">Price: RM 0.20</p>
              </div>
              <button
                class="mt-2 w-full rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 add-button"
                data-item-id="3" data-item-name="cola" data-item-price="0.20">
                Add to cart
              </button>
            </div>
          </div>
          <!-- Item 4 -->
          <div
            class="group relative overflow-hidden rounded-2xl border border-white/60 bg-white/80 p-4 shadow-lg transition hover:-translate-y-1 hover:shadow-xl">
            <div
              class="absolute inset-0 bg-gradient-to-br from-white/70 via-white/40 to-transparent opacity-0 transition group-hover:opacity-100">
            </div>
            <div class="relative flex flex-col items-center gap-3 text-center">
              <img src="/images/lime.png" alt="lime" class="h-28 w-28 sm:h-32 sm:w-32" />
              <div>
                <p class="text-lg font-['Space_Grotesk'] font-semibold">Lime</p>
                <p class="text-sm text-slate-500">Price: RM 0.20</p>
              </div>
              <button
                class="mt-2 w-full rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 add-button"
                data-item-id="4" data-item-name="lime" data-item-price="0.20">
                Add to cart
              </button>
            </div>
          </div>
          <!-- Item 5 -->
          <div
            class="group relative overflow-hidden rounded-2xl border border-white/60 bg-white/80 p-4 shadow-lg transition hover:-translate-y-1 hover:shadow-xl">
            <div
              class="absolute inset-0 bg-gradient-to-br from-white/70 via-white/40 to-transparent opacity-0 transition group-hover:opacity-100">
            </div>
            <div class="relative flex flex-col items-center gap-3 text-center">
              <img src="/images/noodle.png" alt="noodle" class="h-28 w-28 sm:h-32 sm:w-32" />
              <div>
                <p class="text-lg font-['Space_Grotesk'] font-semibold">Noodle</p>
                <p class="text-sm text-slate-500">Price: RM 0.20</p>
              </div>
              <button
                class="mt-2 w-full rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 add-button"
                data-item-id="5" data-item-name="noodle" data-item-price="0.20">
                Add to cart
              </button>
            </div>
          </div>
          <!-- Item 6 -->
          <div
            class="group relative overflow-hidden rounded-2xl border border-white/60 bg-white/80 p-4 shadow-lg transition hover:-translate-y-1 hover:shadow-xl">
            <div
              class="absolute inset-0 bg-gradient-to-br from-white/70 via-white/40 to-transparent opacity-0 transition group-hover:opacity-100">
            </div>
            <div class="relative flex flex-col items-center gap-3 text-center">
              <img src="/images/soda.png" alt="soda" class="h-28 w-28 sm:h-32 sm:w-32" />
              <div>
                <p class="text-lg font-['Space_Grotesk'] font-semibold">Soda</p>
                <p class="text-sm text-slate-500">Price: RM 0.20</p>
              </div>
              <button
                class="mt-2 w-full rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 add-button"
                data-item-id="6" data-item-name="soda" data-item-price="0.20">
                Add to cart
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Cart Container -->
      <aside class="rounded-3xl border border-white/70 bg-white/80 p-6 shadow-lg lg:sticky lg:top-6 h-fit">
        <h2 class="text-2xl font-['Space_Grotesk'] font-semibold">Cart</h2>
        <div id="cart" class="mt-4 min-h-[140px] rounded-2xl border border-slate-200/70 bg-white/70 p-4">
          <p class="text-center text-slate-500">Your cart is empty.</p>
        </div>

        <div class="mt-6 grid gap-4">
          <div class="rounded-2xl border border-slate-200/70 bg-white/70 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">Payment</p>
            <div class="mt-3 grid gap-3">
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="radio" name="paymentMethod" value="eShop2Online" id="eShop2Online"
                  class="h-4 w-4 accent-emerald-500" />
                <label for="eShop2Online" class="text-sm font-medium text-slate-700">
                  Online Banking/E-Wallet
                </label>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="radio" name="paymentMethod" value="eShop2QR" id="eShop2QR"
                  class="h-4 w-4 accent-emerald-500" />
                <label for="eShop2QR" class="text-sm font-medium text-slate-700">eShop2 Duit Now</label>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="radio" name="paymentMethod" value="eShop2ARgo" id="eShop2ARgo"
                  class="h-4 w-4 accent-emerald-500" />
                <label for="eShop2ARgo" class="text-sm font-medium text-slate-700">ARgo Payment</label>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="radio" name="paymentMethod" value="arvdnqr" checked id="arvdnqr"
                  class="h-4 w-4 accent-emerald-500" />
                <label for="arvdnqr" class="text-sm font-medium text-slate-700">Duit Now</label>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200/70 bg-white/70 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">Machine</p>
            <div class="mt-3 grid gap-3">
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="radio" name="machine_id" value="P02562601290001" checked id="P02562601290001"
                  class="h-4 w-4 accent-emerald-500" />
                <label for="P02562601290001" class="text-sm font-medium text-slate-700">ARVDNQR Machine</label>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="radio" name="machine_id" value="eshop2test" id="eshop2test"
                  class="h-4 w-4 accent-emerald-500" />
                <label for="eshop2test" class="text-sm font-medium text-slate-700">eShop2 Machine</label>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="radio" name="machine_id" value="eshop2testjp" id="eshop2testjp"
                  class="h-4 w-4 accent-emerald-500" />
                <label for="eshop2testjp" class="text-sm font-medium text-slate-700">eShop2 JingPin Machine</label>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="radio" name="machine_id" value="unregistered" id="unregistered"
                  class="h-4 w-4 accent-emerald-500" />
                <label for="unregistered" class="text-sm font-medium text-slate-700">Un-registered ID</label>
              </div>
            </div>
          </div>
        </div>

        <form method="POST" id="checkout_form" action="/offline" class="mt-6 grid gap-4">
          <input type="hidden" name="cartData" id="cartData"
            value='{"machine_id": "P02562601290001", "payment_method": "arvdnqr"}' />
          <div class="rounded-2xl border border-slate-200/70 bg-white/70 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">Delivery</p>
            <div class="mt-3 grid gap-3">
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="radio" name="delivery" value="random" id="random_delivery" checked
                  class="h-4 w-4 accent-emerald-500" />
                <label for="random_delivery" class="text-sm font-medium text-slate-700">
                  Random delivery status
                </label>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="radio" name="delivery" value="success" id="success_delivery"
                  class="h-4 w-4 accent-emerald-500" />
                <label for="success_delivery" class="text-sm font-medium text-slate-700">All success</label>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="radio" name="delivery" value="failed" id="failed_delivery"
                  class="h-4 w-4 accent-emerald-500" />
                <label for="failed_delivery" class="text-sm font-medium text-slate-700">All failed</label>
              </div>
              <label class="flex items-center gap-3 rounded-xl border border-slate-200/70 bg-white px-3 py-2">
                <input type="checkbox" name="no_dstatus" id="no_dstatus" class="h-4 w-4 accent-emerald-500" />
                <span class="text-sm font-medium text-slate-700">Do not send delivery status</span>
              </label>
              <div class="grid gap-2">
                <label for="stoppoint" class="text-sm font-medium text-slate-700">
                  Set the stop point
                </label>
                <input type="number" name="stoppoint" id="stoppoint"
                  class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm" step="1" min="0" />
              </div>
            </div>
          </div>

          <input type="submit" value="Checkout"
            class="mt-1 w-full rounded-full bg-emerald-500 px-4 py-3 text-sm font-semibold text-white transition hover:bg-emerald-400" />
        </form>
      </aside>
    </section>
  </main>
</body>

<script>
  const addBtns = document.querySelectorAll(".add-button");
  const form = document.getElementById("checkout_form");
  const paymentMethodInputs = document.querySelectorAll(
    'input[name="paymentMethod"]'
  );
  const machineIdInputs = document.querySelectorAll(
    'input[name="machine_id"]'
  );

  const cart = document.getElementById("cart");
  const cartDataInput = document.getElementById("cartData");

  const cartItems = [];

  paymentMethodInputs.forEach((input) => {
    input.addEventListener("change", () => {
      if (input.value == "eShop2Online") {
        form.method = "GET";
        checkout_form.action = "/online";
      } else if (input.value == "eShop2ARgo") {
        form.method = "GET";
        checkout_form.action = "/argo";
      } else {
        form.method = "POST";
        checkout_form.action = "/offline";
      }
      cartDataInput.value = JSON.stringify({
        ...JSON.parse(cartDataInput.value || "{}"),
        payment_method: input.value,
      });

      if (input.value == "eShop2Online" || input.value == "eShop2QR" || input.value == "eShop2ARgo") {
        // Check if any eShop2 machine is already selected
        let eshop2Selected = false;
        let selectedEshop2Machine = "";

        machineIdInputs.forEach((radio) => {
          if ((radio.value == "eshop2testjp" || radio.value == "eshop2test" || radio.value == "eshop2argo") && radio.checked) {
            eshop2Selected = true;
            selectedEshop2Machine = radio.value;
          }
        });

        // If an eShop2 machine is already selected, keep it; otherwise default to eshop2test
        if (eshop2Selected) {
          cartDataInput.value = JSON.stringify({
            ...JSON.parse(cartDataInput.value || "{}"),
            machine_id: selectedEshop2Machine,
          });
        } else {
          machineIdInputs.forEach((radio) => {
            if (radio.value == "eshop2test") {
              radio.checked = true;
              cartDataInput.value = JSON.stringify({
                ...JSON.parse(cartDataInput.value || "{}"),
                machine_id: "eshop2test",
              });
            }
          });
        }
      } else {
        machineIdInputs.forEach((radio) => {
          if (radio.value == "P02562601290001") {
            radio.checked = true;
            cartDataInput.value = JSON.stringify({
              ...JSON.parse(cartDataInput.value || "{}"),
              machine_id: "P02562601290001",
            });
          }
        });
      }

    });
  });

  machineIdInputs.forEach((input) => {
    input.addEventListener("change", (e) => {
      const selectedMachineId = e.target.value;
      const originalCartData = JSON.parse(cartDataInput.value || "{}");
      cartDataInput.value = JSON.stringify({
        ...originalCartData,
        machine_id: selectedMachineId,
      });

      if (input.value == "P02562601290001") {
        paymentMethodInputs.forEach((radio) => {
          if (radio.value == "arvdnqr") {
            radio.checked = true;
            form.method = "POST";
            checkout_form.action = "/offline";
            cartDataInput.value = JSON.stringify({
              ...JSON.parse(cartDataInput.value || "{}"),
              payment_method: "arvdnqr",
            });
          }
        });
      } else if (input.value == "eshop2test" || input.value == "eshop2testjp") {
        paymentMethodInputs.forEach((radio) => {
          if (radio.value == "eShop2QR") {
            radio.checked = true;
            form.method = "POST";
            checkout_form.action = "/offline";
            cartDataInput.value = JSON.stringify({
              ...JSON.parse(cartDataInput.value || "{}"),
              payment_method: "eShop2QR",
            });
          }
        });
      }

    });
  });

  form.addEventListener("submit", (e) => {
    if (cartItems.length === 0) {
      e.preventDefault();
      alert("Your cart is empty. Please add items to the cart.");
    }
  });

  // Add to cart button event listeners
  addBtns.forEach((button) => {
    button.addEventListener("click", () => {
      const itemId = button.getAttribute("data-item-id");
      const itemName = button.getAttribute("data-item-name");
      const itemPrice = button.getAttribute("data-item-price");

      let itemExists = false;
      cartItems.forEach((item) => {
        if (item.id === itemId) {
          item.quantity += 1;
          itemExists = true;
          return;
        }
      });

      if (!itemExists) {
        cartItems.push({
          id: itemId,
          name: itemName,
          price: parseFloat(itemPrice),
          quantity: 1,
        });
      }
      renderCart();

      const originalCartData = JSON.parse(cartDataInput.value || "{}");
      cartDataInput.value = JSON.stringify({
        ...originalCartData,
        cartItems: cartItems,
        total: calculateTotal(),
      });
    });
  });

  // Remove from cart (event delegation)
  cart.addEventListener("click", (event) => {
    const target = event.target;
    if (!target.classList.contains("remove-button")) {
      return;
    }

    const itemId = target.getAttribute("data-item-id");
    const itemIndex = cartItems.findIndex((item) => item.id === itemId);
    if (itemIndex === -1) {
      return;
    }

    cartItems[itemIndex].quantity -= 1;
    if (cartItems[itemIndex].quantity <= 0) {
      cartItems.splice(itemIndex, 1);
    }

    renderCart();

    const originalCartData = JSON.parse(cartDataInput.value || "{}");
    cartDataInput.value = JSON.stringify({
      ...originalCartData,
      cartItems: cartItems,
      total: calculateTotal(),
    });
  });

  // Render cart items
  function renderCart() {
    const innerText = cart.querySelector("p");
    if (cartItems.length === 0) {
      innerText.textContent = "Your cart is empty.";
      return;
    }
    innerText.textContent = "";

    cartItems.forEach((item) => {
      const existingItem = cart.querySelector(
        `div[data-item-id="${item.id}"]`
      );

      if (existingItem) {
        const itemPrice = existingItem.querySelector("#item-price");
        const itemTotal = existingItem.querySelector("#item-total");
        itemPrice.textContent = `RM ${item.price.toFixed(2)} x ${item.quantity}`;
        itemTotal.textContent = `RM ${(item.price * item.quantity).toFixed(2)}`;
        return;
      }

      const itemDiv = document.createElement("div");

      itemDiv.classList.add(
        "w-full",
        "flex",
        "justify-between",
        "items-center"
      );
      itemDiv.setAttribute("data-item-id", item.id);

      const text = `
          <img src="/images/${item.name}.png" alt="${item.name}" class="w-[50px] h-[50px]" />
          <p>${item.name}</p>
          <p id="item-price">RM ${item.price.toFixed(2)} x ${item.quantity}</p>
          <p id="item-total">RM ${(item.price * item.quantity).toFixed(2)}</p>
          <button class="remove-button rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-100" data-item-id="${item.id}">
            Remove
          </button>
        `;

      itemDiv.classList.add("mb-2");
      itemDiv.innerHTML = text;
      innerText.appendChild(itemDiv);
    });

    renderTotal();
  }

  // Render total price
  function renderTotal() {
    const totalDiv = document.getElementById("total-div");
    if (totalDiv) {
      totalDiv.remove();
    }

    const div = document.createElement("div");
    div.id = "total-div";
    div.classList.add("mt-4", "text-right", "font-bold");

    const total = calculateTotal();

    const text = `
        <p>Total: RM ${total.toFixed(2)}</p>
      `;

    div.innerHTML = text;
    cart.appendChild(div);
  }

  // Calculate total
  function calculateTotal() {
    return cartItems.reduce((a, c) => {
      if (typeof a === "number") {
        return a + c.price.toFixed(2) * c.quantity;
      }
      a.price.toFixed(2) * a.quantity + c.price.toFixed(2) * c.quantity;
    }, 0);
  }
</script>

</html>