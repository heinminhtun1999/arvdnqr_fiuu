<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Status</title>
  <link rel="stylesheet" href="/stylesheets/build.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  />
  <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"
    integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+"
    crossorigin="anonymous"></script>
</head>

<body
  class="min-h-screen bg-[radial-gradient(1100px_circle_at_10%_10%,#ffe8c7_0%,transparent_55%),radial-gradient(900px_circle_at_90%_0%,#d6f5ff_0%,transparent_50%),linear-gradient(180deg,#f8fafc_0%,#f3f7ff_45%,#f9f6ef_100%)] text-slate-900 font-['Outfit']"
>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-4 py-10">
    <div class="w-full rounded-3xl border border-white/70 bg-white/80 p-6 shadow-xl sm:p-8">
      <p class="text-xs uppercase tracking-[0.4em] text-slate-500">Delivery</p>
      <h1 class="mt-2 text-3xl sm:text-4xl font-['Space_Grotesk'] font-semibold">Order Status</h1>
      <% if (order && success) { %>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <h2 class="text-lg font-semibold text-slate-900">Order <%= order.referenceId %></h2>
          <span class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">
            Amount: RM <%= order.amount %>
          </span>
        </div>
        <div class="mt-6 rounded-3xl border border-slate-200/70 bg-white/80 p-5">
          <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:text-left">
            <img src="/images/package.gif" alt="Delivery" class="h-28 w-28" id="delivery-icon" />
            <div class="flex-1">
              <p id="delivering-text" class="text-lg font-semibold">
                Dispensing <span id="delivering-item" class="text-emerald-600"></span>
              </p>
              <p class="mt-2 text-sm text-slate-600">Watch the live dispense status below.</p>
            </div>
          </div>
          <div class="mt-5 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4" id="delivery-status">
            <div class="rounded-2xl border border-slate-200/70 bg-white px-3 py-2">
              <p class="text-xs uppercase tracking-wider text-slate-500">Total</p>
              <p class="text-lg font-semibold" id="total-items"></p>
            </div>
            <div class="rounded-2xl border border-slate-200/70 bg-white px-3 py-2">
              <p class="text-xs uppercase tracking-wider text-slate-500">Dispensed</p>
              <p class="text-lg font-semibold" id="delivered-items"></p>
            </div>
            <div class="rounded-2xl border border-slate-200/70 bg-white px-3 py-2">
              <p class="text-xs uppercase tracking-wider text-slate-500">Success</p>
              <p class="text-lg font-semibold text-emerald-600" id="success-count"></p>
            </div>
            <div class="rounded-2xl border border-slate-200/70 bg-white px-3 py-2">
              <p class="text-xs uppercase tracking-wider text-slate-500">Failed</p>
              <p class="text-lg font-semibold text-rose-500" id="failed-count"></p>
            </div>
          </div>
        </div>
      <% } else if (!success) { %>
        <div class="mt-6 rounded-3xl border border-rose-200 bg-rose-50 p-5">
          <h2 class="text-lg font-semibold text-rose-600">Error</h2>
          <p class="mt-2 text-sm text-rose-700"><%= message %></p>
        </div>
      <% } %>
      <button
        onclick="window.location.href=`<%= isTesting ? '/testing' : '/' %>`"
        class="mt-6 w-full rounded-full bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-slate-800 disabled:bg-slate-300"
        id="bth_btn"
        disabled
      >
        Back to Home
      </button>
    </div>
  </main>
</body>

<script type="text/javascript">
  const socket = io();

  const totalItemsElement = document.getElementById("total-items");
  const deliveredItemsElement = document.getElementById("delivered-items");
  const successCountElement = document.getElementById("success-count");
  const failedCountElement = document.getElementById("failed-count");
  const deliveringItemElement = document.getElementById("delivering-item");
  const deliveringTextElement = document.getElementById("delivering-text");
  const deliveryIconElement = document.getElementById("delivery-icon");
  const backToHomeButton = document.getElementById("bth_btn");

  socket.on("connect", function () {
    console.log("Connected to server via Socket.io");
  });
  if ("<%= success %>" == "false" ) {
    backToHomeButton.disabled = false;
  }

  console.log("success", "<%= success %>" )
  console.log("order", "<%= order %>")
  console.log("<%= order %>" && "<%= success %>")
  console.log("<%= order.referenceId %>" && "<%= success %>")
  console.log("order.referenceId", "<%= order.referenceId %>")
  if ("<%= order.referenceId %>" && "<%= success %>") {
    socket.emit("joinOrderRoom", "<%= order.referenceId %>");

    socket.emit("readyToDeliver", "<%= order.referenceId %>");

    socket.on("deliveryStatus", (data) => {
      console.log("Delivery Status Update:", data);
      totalItemsElement.textContent = data.total;
      deliveredItemsElement.textContent = data.itemDelivered;
      successCountElement.textContent = data.successCount;
      failedCountElement.textContent = data.itemDelivered - data.successCount;

      if (data.itemDelivered < data.total) {
        deliveringItemElement.textContent = `Item ${data.itemDelivered + 1}`;
      } else {
        deliveringTextElement.textContent = "All items dispensed.";
        deliveringItemElement.textContent = "";
        deliveryIconElement.src = "/images/verified.gif";
        backToHomeButton.disabled = false;
      }
    });
  }
</script>

</html>